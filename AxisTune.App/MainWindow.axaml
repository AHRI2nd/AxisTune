<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AxisTune.App.ViewModels"
        xmlns:ctrl="using:AxisTune.App.Controls"
        xmlns:l="using:AxisTune.App.Localization"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="720"
        x:Class="AxisTune.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="880" Height="600"
        MinWidth="740" MinHeight="470"
        Icon="/Assets/app.ico"
        Title="AxisTune">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="20">

        <!-- 헤더: 상태 + 드라이버 On/Off (항상 표시) -->
        <Border Grid.Row="0" Background="#1E1E22" CornerRadius="12" Padding="18">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Ellipse Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                         Fill="{Binding StatusColor}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#9AA0A6" TextWrapping="Wrap"
                               IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding VirtualSlotText}" FontSize="12" Foreground="#4C8DF6"
                               IsVisible="{Binding VirtualSlotText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="{l:Loc Header_Driver}" VerticalAlignment="Center" Foreground="#C8CCD0" />
                    <ToggleSwitch IsChecked="{Binding IsDriverEnabled}" OnContent="On" OffContent="Off" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 드라이버 미설치 경고 -->
        <Border Grid.Row="1" Margin="0,12,0,0" Background="#3A2A00" CornerRadius="10" Padding="12"
                IsVisible="{Binding AnyDriverMissing}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FFD479"
                           Text="{l:Loc Banner_DriversMissing}" />
                <Button Grid.Column="1" Content="{l:Loc Banner_InstallDrivers}" Command="{Binding GoToDriversCommand}" />
            </Grid>
        </Border>

        <!-- 업데이트 알림 배너 -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="#13351F" CornerRadius="10" Padding="12"
                IsVisible="{Binding UpdateAvailable}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#7CE7A6"
                           Text="{Binding UpdateText}" />
                <Button Grid.Column="1" Content="{l:Loc Update_Download}" Command="{Binding OpenUpdateCommand}" />
                <Button Grid.Column="2" Content="{l:Loc Update_Dismiss}" Command="{Binding DismissUpdateCommand}" />
            </Grid>
        </Border>

        <!-- 프로파일 바 -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="#1A1A20" CornerRadius="10" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{l:Loc Profile_Label}" VerticalAlignment="Center" Foreground="#C8CCD0" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileListItemViewModel">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="{l:Loc Profile_Add}" Command="{Binding AddProfileCommand}" />
                <Button Grid.Column="3" Content="{l:Loc Profile_Delete}" Command="{Binding DeleteProfileCommand}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="4" Margin="0,12,0,0" TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ===== 장치 탭 ===== -->
            <TabItem Header="{l:Loc Tab_Devices}">
                <ScrollViewer Margin="0,12,0,0" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{l:Loc Dev_InputDevice}" FontSize="14" FontWeight="SemiBold" Foreground="#C8CCD0" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          PlaceholderText="{l:Loc Dev_Placeholder}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="{l:Loc Dev_Refresh}" Command="{Binding RefreshDevicesCommand}" />
                            </Grid>
                            <TextBlock Text="{l:Loc Dev_AutoNote}" FontSize="12" Foreground="#7A8088" />
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock Text="{l:Loc Settings_Title}" FontSize="14" FontWeight="SemiBold" Foreground="#C8CCD0" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:Loc Settings_ProfileName}" />
                                <TextBox Text="{Binding ActiveProfileName}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:Loc Settings_Language}" />
                                <ComboBox SelectedIndex="{Binding LanguageIndex}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem>한국어</ComboBoxItem>
                                    <ComboBoxItem>English</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc Set_RunAtStartup}" />
                                    <TextBlock Text="{l:Loc Set_RunAtStartup_Sub}" FontSize="11" Foreground="#7A8088" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunAtStartup}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc Set_MinTray}" />
                                    <TextBlock Text="{l:Loc Set_MinTray_Sub}" FontSize="11" Foreground="#7A8088" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc Set_AutoEnable}" />
                                    <TextBlock Text="{l:Loc Set_AutoEnable_Sub}" FontSize="11" Foreground="#7A8088" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoEnableOnStartup}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc Set_CheckUpdates}" />
                                    <TextBlock Text="{l:Loc Set_CheckUpdates_Sub}" FontSize="11" Foreground="#7A8088" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdatesOnStartup}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentVersionText}" FontSize="12" Foreground="#C8CCD0" />
                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Foreground="#7A8088"
                                               IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{l:Loc Update_CheckNow}" Command="{Binding CheckUpdatesNowCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 튜닝 탭 (좌: 컨텍스트 패널 / 우: 게임패드) ===== -->
            <TabItem Header="{l:Loc Tab_Tuning}">
                <Grid ColumnDefinitions="290,*" Margin="0,8,0,0" ColumnSpacing="12">
                    <Border Grid.Column="0" Background="#15151A" CornerRadius="12" Padding="14">
                      <ScrollViewer AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                          <TextBlock Text="{Binding PanelHint}" Foreground="#9AA0A6" FontSize="13" TextWrapping="Wrap"
                                     IsVisible="{Binding PanelHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <StackPanel Spacing="14" IsVisible="{Binding ShowTuningEditor}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedChannel.Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StickAxisY}" OnContent="Y" OffContent="X"
                                              IsVisible="{Binding IsStickSelected}" />
                            </Grid>

                            <ctrl:CurveEditor Height="200"
                                              Points="{Binding SelectedChannel.Points}"
                                              Interpolation="{Binding SelectedChannel.Interpolation}"
                                              InnerDeadzone="{Binding SelectedChannel.InnerDeadzone}"
                                              OuterDeadzone="{Binding SelectedChannel.OuterDeadzone}"
                                              PreviewInput="{Binding SelectedChannel.PreviewInput}" />

                            <TextBlock FontSize="11" Foreground="#7A8088" Text="{l:Loc Tune_CurveHint}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Grid.Column="0" Content="{l:Loc Tune_PresetLinear}" HorizontalAlignment="Stretch"
                                        Command="{Binding SelectedChannel.PresetLinearCommand}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Content="{l:Loc Tune_PresetAggressive}" Command="{Binding SelectedChannel.PresetAggressiveCommand}" />
                                    <Button Content="{l:Loc Tune_PresetSmooth}" Command="{Binding SelectedChannel.PresetSmoothCommand}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{l:Loc Tune_InputMin}" Width="92" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.95"
                                            Value="{Binding SelectedChannel.InputMin}" />
                                    <TextBlock Grid.Column="2" Width="44" TextAlignment="Right"
                                               Text="{Binding SelectedChannel.InputMin, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{l:Loc Tune_InputMax}" Width="92" />
                                    <Slider Grid.Column="1" Minimum="0.05" Maximum="1"
                                            Value="{Binding SelectedChannel.InputMax}" />
                                    <TextBlock Grid.Column="2" Width="44" TextAlignment="Right"
                                               Text="{Binding SelectedChannel.InputMax, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{l:Loc Tune_InnerDeadzone}" Width="92" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.9"
                                            Value="{Binding SelectedChannel.InnerDeadzone}" />
                                    <TextBlock Grid.Column="2" Width="44" TextAlignment="Right"
                                               Text="{Binding SelectedChannel.InnerDeadzone, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{l:Loc Tune_OuterDeadzone}" Width="92" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.9"
                                            Value="{Binding SelectedChannel.OuterDeadzone}" />
                                    <TextBlock Grid.Column="2" Width="44" TextAlignment="Right"
                                               Text="{Binding SelectedChannel.OuterDeadzone, StringFormat='{}{0:P0}'}" />
                                </Grid>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{l:Loc Tune_Interp}" VerticalAlignment="Center" />
                                    <ComboBox SelectedIndex="{Binding SelectedChannel.InterpolationIndex}">
                                        <ComboBoxItem Content="{l:Loc Tune_Interp_Linear}" />
                                        <ComboBoxItem Content="{l:Loc Tune_Interp_Cubic}" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{l:Loc Tune_Invert}" VerticalAlignment="Center" />
                                    <ToggleSwitch IsChecked="{Binding SelectedChannel.Invert}" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#1A1A20" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{l:Loc Tune_PreviewTitle}" FontSize="12" Foreground="#9AA0A6" />
                                    <TextBlock FontSize="13">
                                        <Run Text="{l:Loc Tune_PreviewIn}" />
                                        <Run Text="{Binding SelectedChannel.PreviewInput, StringFormat='{}{0:P0}'}" Foreground="#4C8DF6" />
                                        <Run Text="{l:Loc Tune_PreviewArrow}" />
                                        <Run Text="{Binding SelectedChannel.PreviewOutput, StringFormat='{}{0:P0}'}" Foreground="#34C759" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#7A8088" Text="{l:Loc Tune_PreviewNote}" />
                                </StackPanel>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                      </ScrollViewer>
                    </Border>
                    <ctrl:ControllerView Grid.Column="1" SelectedControl="{Binding SelectedControl}" LiveState="{Binding LiveState}" />
                </Grid>
            </TabItem>

            <!-- ===== 매핑 탭 (좌: 선택 컨트롤 바인딩 / 우: 게임패드) ===== -->
            <TabItem Header="{l:Loc Tab_Mapping}">
                <Grid ColumnDefinitions="290,*" Margin="0,8,0,0" ColumnSpacing="12">
                    <Border Grid.Column="0" Background="#15151A" CornerRadius="12" Padding="14">
                      <ScrollViewer AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Grid.Column="0">
                                  <TextBlock Text="{l:Loc Map_Use}" FontWeight="SemiBold" />
                                  <TextBlock Text="{l:Loc Map_Use_Sub}" FontSize="11" Foreground="#7A8088" />
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ManualMappingEnabled}" />
                          </Grid>

                          <TextBlock Text="{Binding PanelHint}" Foreground="#9AA0A6" FontSize="13" TextWrapping="Wrap"
                                     IsVisible="{Binding PanelHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                          <StackPanel IsVisible="{Binding ShowMappingRows}" IsEnabled="{Binding ManualMappingEnabled}" Spacing="2">
                              <ItemsControl ItemsSource="{Binding SelectedMappingRows}">
                                  <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:BindingRowViewModel">
                                          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4" ColumnSpacing="8">
                                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                  <TextBlock Text="{Binding Label}" />
                                                  <TextBlock Text="{Binding BindingText}" FontSize="11" Foreground="#9AA0A6" />
                                              </StackPanel>
                                              <Button Grid.Column="1" Content="{Binding CaptureLabel}" Command="{Binding BindCommand}" />
                                              <Button Grid.Column="2" Content="✕" Command="{Binding ClearCommand}" />
                                          </Grid>
                                      </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                              </ItemsControl>
                          </StackPanel>
                        </StackPanel>
                      </ScrollViewer>
                    </Border>
                    <ctrl:ControllerView Grid.Column="1" SelectedControl="{Binding SelectedControl}" LiveState="{Binding LiveState}" />
                </Grid>
            </TabItem>

            <!-- ===== 드라이버 탭 ===== -->
            <TabItem Header="{l:Loc Tab_Drivers}">
                <ScrollViewer Margin="0,12,0,0" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">
                        <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" FontSize="12" Text="{l:Loc Drv_Intro}" />

                        <!-- ViGEmBus -->
                        <Border Background="#1A1A20" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                                             Fill="{Binding ViGEmDriver.StatusColor}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding ViGEmDriver.Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ViGEmDriver.Description}" FontSize="11" Foreground="#7A8088" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{Binding ViGEmDriver.StatusText}"
                                               Foreground="{Binding ViGEmDriver.StatusColor}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{l:Loc Drv_Install}" Command="{Binding ViGEmDriver.InstallCommand}"
                                            IsEnabled="{Binding !ViGEmDriver.IsBusy}" />
                                    <Button Content="{l:Loc Drv_DownloadPage}" Command="{Binding ViGEmDriver.OpenPageCommand}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#7A8088"
                                               Text="{Binding ViGEmDriver.BusyText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- HidHide -->
                        <Border Background="#1A1A20" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                                             Fill="{Binding HidHideDriver.StatusColor}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding HidHideDriver.Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HidHideDriver.Description}" FontSize="11" Foreground="#7A8088" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{Binding HidHideDriver.StatusText}"
                                               Foreground="{Binding HidHideDriver.StatusColor}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{l:Loc Drv_Install}" Command="{Binding HidHideDriver.InstallCommand}"
                                            IsEnabled="{Binding !HidHideDriver.IsBusy}" />
                                    <Button Content="{l:Loc Drv_DownloadPage}" Command="{Binding HidHideDriver.OpenPageCommand}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#7A8088"
                                               Text="{Binding HidHideDriver.BusyText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="11" Foreground="#5F656D" TextWrapping="Wrap" Text="{l:Loc Drv_Footer}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
