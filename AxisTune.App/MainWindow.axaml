<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AxisTune.App.ViewModels"
        xmlns:ctrl="using:AxisTune.App.Controls"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="720"
        x:Class="AxisTune.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="560" Height="740"
        MinWidth="500" MinHeight="640"
        Icon="/Assets/app.ico"
        Title="AxisTune">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">

        <!-- 헤더: 상태 + 드라이버 On/Off (항상 표시) -->
        <Border Grid.Row="0" Background="#1E1E22" CornerRadius="12" Padding="18">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Ellipse Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                         Fill="{Binding StatusColor}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#9AA0A6"
                               IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="드라이버" VerticalAlignment="Center" Foreground="#C8CCD0" />
                    <ToggleSwitch IsChecked="{Binding IsDriverEnabled}" OnContent="On" OffContent="Off" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 드라이버 미설치 경고 -->
        <Border Grid.Row="1" Margin="0,12,0,0" Background="#3A2A00" CornerRadius="10" Padding="12"
                IsVisible="{Binding AnyDriverMissing}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FFD479"
                           Text="⚠ 필수 드라이버가 설치되어 있지 않습니다. 드라이버 탭에서 설치하세요." />
                <Button Grid.Column="1" Content="드라이버 설치" Command="{Binding GoToDriversCommand}" />
            </Grid>
        </Border>

        <!-- 프로파일 바 -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="#1A1A20" CornerRadius="10" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="프로파일" VerticalAlignment="Center" Foreground="#C8CCD0" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileListItemViewModel">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="추가" Command="{Binding AddProfileCommand}" />
                <Button Grid.Column="3" Content="삭제" Command="{Binding DeleteProfileCommand}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="3" Margin="0,12,0,0" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ===== 장치 탭 ===== -->
            <TabItem Header="장치">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="입력 장치" FontSize="14" FontWeight="SemiBold" Foreground="#C8CCD0" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          PlaceholderText="감지된 컨트롤러를 선택하세요">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="새로고침" Command="{Binding RefreshDevicesCommand}" />
                            </Grid>
                            <TextBlock Text="Xbox · PlayStation · Switch(Pro/Joy-Con)는 자동 감지됩니다."
                                       FontSize="12" Foreground="#7A8088" />
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock Text="설정" FontSize="14" FontWeight="SemiBold" Foreground="#C8CCD0" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="활성 프로파일 이름" />
                                <TextBox Text="{Binding ActiveProfileName}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Windows 시작 시 자동 실행" />
                                    <TextBlock Text="로그인 시 백그라운드(트레이)로 실행" FontSize="11" Foreground="#7A8088" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunAtStartup}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="창 닫기 시 트레이로 최소화" />
                                    <TextBlock Text="끄면 닫기(X) 시 완전 종료" FontSize="11" Foreground="#7A8088" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="시작 시 드라이버 자동 On" />
                                    <TextBlock Text="앱 실행과 동시에 가상 출력 활성화" FontSize="11" Foreground="#7A8088" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoEnableOnStartup}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 튜닝 탭 ===== -->
            <TabItem Header="튜닝">
                <Grid ColumnDefinitions="170,*" Margin="0,12,0,0" ColumnSpacing="14">

                    <!-- 채널 목록 -->
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AxisTuningViewModel">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 편집 패널 -->
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="14" IsVisible="{Binding SelectedChannel, Converter={x:Static ObjectConverters.IsNotNull}}">

                            <ctrl:CurveEditor Height="240"
                                              Points="{Binding SelectedChannel.Points}"
                                              Interpolation="{Binding SelectedChannel.Interpolation}"
                                              InnerDeadzone="{Binding SelectedChannel.InnerDeadzone}"
                                              OuterDeadzone="{Binding SelectedChannel.OuterDeadzone}"
                                              PreviewInput="{Binding SelectedChannel.PreviewInput}" />

                            <TextBlock FontSize="11" Foreground="#7A8088"
                                       Text="더블클릭: 점 추가 · 드래그: 이동 · 우클릭: 점 삭제" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Grid.Column="0" Content="프리셋: 선형" HorizontalAlignment="Stretch"
                                        Command="{Binding SelectedChannel.PresetLinearCommand}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Content="공격적" Command="{Binding SelectedChannel.PresetAggressiveCommand}" />
                                    <Button Content="부드럽게" Command="{Binding SelectedChannel.PresetSmoothCommand}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="입력 최소" Width="80" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.95"
                                            Value="{Binding SelectedChannel.InputMin}" />
                                    <TextBlock Grid.Column="2" Width="44" TextAlignment="Right"
                                               Text="{Binding SelectedChannel.InputMin, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="입력 최대" Width="80" />
                                    <Slider Grid.Column="1" Minimum="0.05" Maximum="1"
                                            Value="{Binding SelectedChannel.InputMax}" />
                                    <TextBlock Grid.Column="2" Width="44" TextAlignment="Right"
                                               Text="{Binding SelectedChannel.InputMax, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="중앙 데드존" Width="80" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.9"
                                            Value="{Binding SelectedChannel.InnerDeadzone}" />
                                    <TextBlock Grid.Column="2" Width="44" TextAlignment="Right"
                                               Text="{Binding SelectedChannel.InnerDeadzone, StringFormat='{}{0:P0}'}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="외곽 데드존" Width="80" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.9"
                                            Value="{Binding SelectedChannel.OuterDeadzone}" />
                                    <TextBlock Grid.Column="2" Width="44" TextAlignment="Right"
                                               Text="{Binding SelectedChannel.OuterDeadzone, StringFormat='{}{0:P0}'}" />
                                </Grid>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="곡선 보간" VerticalAlignment="Center" />
                                    <ComboBox SelectedIndex="{Binding SelectedChannel.InterpolationIndex}">
                                        <ComboBoxItem>선형</ComboBoxItem>
                                        <ComboBoxItem>부드럽게(단조 3차)</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="축 반전" VerticalAlignment="Center" />
                                    <ToggleSwitch IsChecked="{Binding SelectedChannel.Invert}" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#1A1A20" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="실시간 미리보기" FontSize="12" Foreground="#9AA0A6" />
                                    <TextBlock FontSize="13">
                                        <Run Text="입력 " />
                                        <Run Text="{Binding SelectedChannel.PreviewInput, StringFormat='{}{0:P0}'}" Foreground="#4C8DF6" />
                                        <Run Text="   →   출력 " />
                                        <Run Text="{Binding SelectedChannel.PreviewOutput, StringFormat='{}{0:P0}'}" Foreground="#34C759" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#7A8088"
                                               Text="튜닝 탭에서 컨트롤러를 움직이면 곡선 위에 현재 위치가 표시됩니다." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== 매핑 탭 ===== -->
            <TabItem Header="매핑">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="수동 매핑 사용" FontWeight="SemiBold" />
                            <TextBlock Text="미인식 컨트롤러를 Xbox 컨트롤로 직접 지정합니다." FontSize="11" Foreground="#7A8088" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ManualMappingEnabled}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="11" Foreground="#7A8088"
                               Text="[바인딩]을 누른 뒤 물리 버튼/축을 움직이면 해당 입력이 지정됩니다. (장치 선택 필요)" />

                    <ScrollViewer Grid.Row="2" Margin="0,10,0,0"
                                  IsEnabled="{Binding ManualMappingEnabled}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="버튼" FontWeight="SemiBold" Foreground="#C8CCD0" />
                                    <Button Grid.Column="1" Content="전체 지우기" Command="{Binding Mapping.ClearAllCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Mapping.ButtonRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BindingRowViewModel">
                                            <Grid ColumnDefinitions="110,*,Auto,Auto" Margin="0,2" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding BindingText}" VerticalAlignment="Center" Foreground="#9AA0A6" />
                                                <Button Grid.Column="2" Content="{Binding CaptureLabel}" Command="{Binding BindCommand}" />
                                                <Button Grid.Column="3" Content="✕" Command="{Binding ClearCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="축(스틱·트리거)" FontWeight="SemiBold" Foreground="#C8CCD0" />
                                <ItemsControl ItemsSource="{Binding Mapping.AxisRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BindingRowViewModel">
                                            <Grid ColumnDefinitions="110,*,Auto,Auto" Margin="0,2" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding BindingText}" VerticalAlignment="Center" Foreground="#9AA0A6" />
                                                <Button Grid.Column="2" Content="{Binding CaptureLabel}" Command="{Binding BindCommand}" />
                                                <Button Grid.Column="3" Content="✕" Command="{Binding ClearCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== 드라이버 탭 ===== -->
            <TabItem Header="드라이버">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="14">
                        <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" FontSize="12"
                                   Text="AxisTune는 두 개의 오픈소스 드라이버(Nefarius)를 사용합니다. 아래 [설치]를 누르면 공식 릴리스를 받아 설치 프로그램을 실행합니다. 설치 후 재부팅이 필요할 수 있습니다." />

                        <!-- ViGEmBus -->
                        <Border Background="#1A1A20" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                                             Fill="{Binding ViGEmDriver.StatusColor}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding ViGEmDriver.Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ViGEmDriver.Description}" FontSize="11" Foreground="#7A8088" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{Binding ViGEmDriver.StatusText}"
                                               Foreground="{Binding ViGEmDriver.StatusColor}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="설치" Command="{Binding ViGEmDriver.InstallCommand}"
                                            IsEnabled="{Binding !ViGEmDriver.IsBusy}" />
                                    <Button Content="다운로드 페이지" Command="{Binding ViGEmDriver.OpenPageCommand}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#7A8088"
                                               Text="{Binding ViGEmDriver.BusyText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- HidHide -->
                        <Border Background="#1A1A20" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                                             Fill="{Binding HidHideDriver.StatusColor}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding HidHideDriver.Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HidHideDriver.Description}" FontSize="11" Foreground="#7A8088" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{Binding HidHideDriver.StatusText}"
                                               Foreground="{Binding HidHideDriver.StatusColor}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="설치" Command="{Binding HidHideDriver.InstallCommand}"
                                            IsEnabled="{Binding !HidHideDriver.IsBusy}" />
                                    <Button Content="다운로드 페이지" Command="{Binding HidHideDriver.OpenPageCommand}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#7A8088"
                                               Text="{Binding HidHideDriver.BusyText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="11" Foreground="#5F656D" TextWrapping="Wrap"
                                   Text="설치 상태가 '설치됨'으로 바뀌지 않으면 재부팅 후 앱을 다시 실행하세요." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
